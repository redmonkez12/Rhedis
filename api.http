# Select the "local" environment in WebStorm, then run signIn once.
# WebStorm sends the saved session cookie with later requests automatically.
# Change email/concertId in http-client.env.json and password in the private file.

### Health
# @name health
GET {{baseUrl}}/health

### Sign in as a seeded demo user
# @name signIn
POST {{baseUrl}}/api/auth/sign-in/email
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Current user (requires sign-in)
# @name me
GET {{baseUrl}}/api/v1/me

### Top three popular concerts
# @name popularConcerts
GET {{baseUrl}}/api/v1/concerts/popular

### Concert detail (public; cached for 60 seconds)
# @name concertDetail
GET {{baseUrl}}/api/v1/concerts/{{concertId}}

### Update concert title or start time (requires venue admin sign-in)
# @name updateConcert
PATCH {{baseUrl}}/api/v1/concerts/{{concertId}}
Content-Type: application/json

{
  "title": "Nový název",
  "startsAt": "2027-02-02T20:30:00Z"
}

### Add a PostgreSQL-backed favorite (requires sign-in)
# @name addFavorite
PUT {{baseUrl}}/api/v1/me/favorites/{{concertId}}

### Add a Redis-only favorite (requires sign-in)
# @name addRedisFavorite
PUT {{baseUrl}}/api/v1/me/redis-favorites/{{concertId}}

### Reserve seat A1 for 60 seconds (requires sign-in)
# @name reserveSeatA1
POST {{baseUrl}}/api/v1/concerts/{{concertId}}/seats/A1/reservation

### Check the reservation status of seat A1 (requires sign-in)
# @name seatA1ReservationStatus
GET {{baseUrl}}/api/v1/concerts/{{concertId}}/seats/A1/reservation

### Sign out
# @name signOut
POST {{baseUrl}}/api/auth/sign-out
Origin: {{baseUrl}}
Content-Type: application/json

{}
