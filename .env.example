# Copy to .env and replace both password placeholders with the same local password.
POSTGRES_USER=tickets
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=tickets
POSTGRES_PORT=5433
ADMINER_PORT=8080
REDIS_PORT=6380
DATABASE_URL=postgresql://tickets:replace-with-a-local-password@localhost:5433/tickets
REDIS_URL=redis://localhost:6380
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3100
FRONTEND_ORIGIN=http://localhost:5173
PORT=3100
